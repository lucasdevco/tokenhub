*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log

# Desktop and frontend builds
/build/
/web/node_modules/
/web/dist/
/.impeccable/
/.pnpm-store/

# React log viewer source is not a capture directory
!/web/src/logs/
!/web/src/logs/**
