# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Command binaries
/logging-server/logging-server

logs*/
test_logs/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories and language caches
# vendor/
__pycache__/
*.py[cod]

# Go workspace file
go.work
go.work.sum

# Local environment files (keep shareable examples)
.env
.env.*
!.env.example
!.env.*.example
.env-profiles.json

